# Tobiten Server Environment Configuration

# Network & Server
TOBITEN_HOST=0.0.0.0
TOBITEN_PORT=8080
# Public base URL used for every absolute link; default http://localhost:8080. Include a sub-path if served under one.
# Native API: {BASE_URL}/api/v1. Komga client base: {BASE_URL}/komga (API + discovery OPDS).
# Authenticated shared event stream: {BASE_URL}/api/v1/events.
# Behind Caddy: `books.example.com { reverse_proxy tobiten:8080 }` + TOBITEN_BASE_URL=https://books.example.com
TOBITEN_BASE_URL=http://localhost:8080

# Storage Directories & Independent Volume Redirection (ADR-0015)
TOBITEN_DATA_DIR=./data
# Optional: Redirect persistent series/volume cover artwork to a dedicated volume (defaults to ${TOBITEN_DATA_DIR}/covers)
# TOBITEN_COVERS_DIR=
# Optional: Redirect ephemeral page thumbnails & repack scratch workspace to a separate volume/tmpfs (defaults to ${TOBITEN_DATA_DIR}/cache)
# TOBITEN_CACHE_DIR=
# Maximum disk budget (in MB) for ephemeral inner-page preview thumbnails (LRU evicted)
TOBITEN_THUMB_CACHE_MAX_MB=2048
# Separate disk budget (in MB) for extracted solid RAR/7z pages (LRU evicted; default 4096)
TOBITEN_EXTRACT_CACHE_MAX_MB=4096

# First-Run Admin Bootstrap & Security (ADR-0006, ADR-0014)
# If unset on first run (when 0 users exist), a one-time setup token is emitted to stdout JSON logs.
TOBITEN_ADMIN_USER=
TOBITEN_ADMIN_PASS=
TOBITEN_SECRET_KEY=
# Optional trusted reverse-proxy CIDRs for authentication headers only; never used to build URLs.
TOBITEN_TRUSTED_PROXIES=
# Optional OIDC provisioning defaults; configure the role/labels before enabling OIDC auto-provisioning.
# Group roles live in oidc_group_mappings; label-ID policies in oidc_group_label_policies.
# Default label names must resolve to existing SERVER IDs before use; unknown names fail closed.
TOBITEN_OIDC_DEFAULT_ROLE=
TOBITEN_OIDC_DEFAULT_LABELS=
# Client PAT for `tobiten-cli mcp`: stdio proxy to the running daemon at TOBITEN_BASE_URL/mcp.
# No database access, PostgreSQL supervision, or second daemon; mapped to a named user.
TOBITEN_API_KEY=

# Logging
# Log Level: debug, info, warn, error
TOBITEN_LOG_LEVEL=info
# Log Format: json (default/production), text, table (aligned terminal output)
TOBITEN_LOG_FORMAT=json

# Storage Engine (PostgreSQL-First)
# 'local'    : Tobiten-supervised PostgreSQL subprocess in ${TOBITEN_DATA_DIR}/postgres (Docker image bundles the binaries;
#              bare-metal uses the system PostgreSQL via pg_ctl on PATH or TOBITEN_PG_BIN)
# 'postgres' : Production/Homelab PostgreSQL instance (e.g. postgres://user:password@localhost:5432/tobiten?sslmode=disable)
# local requires an empty URL; postgres requires a non-empty URL. Conflicts refuse startup.
TOBITEN_STORAGE_MODE=local
TOBITEN_DATABASE_URL=
# Optional (local mode, bare-metal): directory containing the PostgreSQL server binaries (pg_ctl, initdb, postgres)
TOBITEN_PG_BIN=
# Moving to hosted PostgreSQL: stop tobitend -> db dump -> db restore --target <url> -> set TOBITEN_DATABASE_URL + TOBITEN_STORAGE_MODE=postgres -> restart.
# The stopped-daemon CLI can temporarily supervise local PG under exclusive maintenance ownership.
# db upgrade requires old/new binaries on bare metal. It retains postgres.pre-<old-major>.bak under TOBITEN_DATA_DIR
# and refuses before mutation if that fixed backup path exists; no automatic backup removal.

# New-Library Mode Default (persisted libraries.mode is authoritative; does not convert existing libraries)
# 'virtual' : In-place, no automatic changes/probes. Explicit admin-confirmed staged-trash disk purge is the sole exception.
# 'managed' : Organizes its configured intake; repacks comic RAR/7z/loose images to CBZ, preserving EPUB/PDF.
# Each managed library requires its own intake path in library configuration; /intake is only an example.
# Roots/intakes must not overlap. Virtual and managed libraries may coexist.
# Ordinary CBZ intake preserves hardlinks; repack/Hide Page/explicit write-back detaches them safely.
# Automatic scraper write-back is per-library opt-in, off by default.
TOBITEN_LIBRARY_MODE=virtual
# Optional scanner worker count; unset uses the conservative default described in ADR-0003.
TOBITEN_SCANNER_WORKERS=
# Managed mode only: how files are taken from each configured intake. 'hardlink' (default; falls back to 'copy' across filesystems) and 'copy'
# leave the original untouched (e.g. for seeding). A same-filesystem direct 'move' renames the input;
# cross-filesystem move sources, repack originals, and move-mode duplicates stay labeled as trash in place until explicit purge.
TOBITEN_INTAKE_MODE=hardlink
